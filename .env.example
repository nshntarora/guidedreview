# Public GitHub OAuth App client ID (device flow — no client secret).
# Create an OAuth App at https://github.com/settings/developers and enable Device Flow.
VITE_GITHUB_CLIENT_ID=

# --- Marketing site analytics (apps/web) — disabled unless ENABLED=true ---
# Production ingest is proxied by a Cloudflare Worker at guidedreview.dev/i/*
# (not part of this repo). Local `next dev` rewrites /i/* to PostHog US cloud.
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_ANALYTICS_KEY=
# NEXT_PUBLIC_ANALYTICS_PROXY_PATH=/i

