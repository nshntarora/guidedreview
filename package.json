{
  "name": "guided-review-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @guided-review/extension",
    "dev:extension": "npm run dev -w @guided-review/extension",
    "dev:web": "npm run dev -w @guided-review/web",
    "dev:cli": "npm run dev -w @guided-review/cli",
    "build": "npm run build:extension && npm run build:web",
    "build:cli": "npm run build -w @guided-review/cli",
    "review": "npm run start -w @guided-review/cli --",
    "build:extension": "npm run build -w @guided-review/extension",
    "build:web": "npm run build -w @guided-review/web",
    "start:web": "npm run start -w @guided-review/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @guided-review/core && npm run test -w @guided-review/extension && npm run test -w @guided-review/cli --if-present && npm run test -w @guided-review/ui --if-present",
    "test:watch": "npm run test:watch -w @guided-review/extension",
    "test:coverage": "npm run test:coverage -w @guided-review/extension",
    "test:e2e": "npm run test:e2e -w @guided-review/extension",
    "test:e2e:ui": "npm run test:e2e:ui -w @guided-review/extension",
    "test:e2e:install": "npm run test:e2e:install -w @guided-review/extension",
    "test:e2e:web": "npm run test:e2e -w @guided-review/web",
    "test:e2e:web:ui": "npm run test:e2e:ui -w @guided-review/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "vite": "^8.1.5",
    "postcss": "^8.5.10",
    "sharp": "^0.35.3",
    "brace-expansion@1": "1.1.17",
    "brace-expansion@5": "5.0.9"
  }
}
